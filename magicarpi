#!/usr/bin/env ruby

if ARGV[0].nil?
    raise 'Missing serial port'
end

Dir.chdir __dir__ do
    require 'bundler/setup'
    require 'dotenv/load'
    require 'active_record'
end

require 'ostruct'
require 'fcntl'

puts 'Connecting to database'

ActiveRecord::Base.establish_connection(ENV['MAGICARPI_DB'])

if ENV['DEBUG']
    require 'logger'
    ActiveRecord::Base.logger = Logger.new(STDOUT)
end

require_relative 'lib/models/wireless_network_log'
require_relative 'lib/models/wireless_network_dump'
require_relative 'lib/net/iwlist_network'
require_relative 'lib/net/iwlist_scan'
require_relative 'lib/gps_scanner'
require_relative 'lib/network_scanner'
require_relative 'lib/util'
require_relative 'lib/nmea/field_spec'
require_relative 'lib/nmea/sentence'
require_relative 'lib/time_service'

puts 'Starting GPS'

Thread.new do
    GpsScanner.run(ARGV[0])
end

# Give the GPS scanner a few seconds to start.
sleep 5

puts 'Starting network scanner'

Thread.new do
    NetworkScanner.run
end

puts 'Starting time service'

Thread.new do
    TimeService.run
end

puts 'Startup finished'

# Nothing to do. May as well relax.
# puts 'Main thread is going to sleep... zzz'
loop do
    sleep 5
end
